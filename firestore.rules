rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return isSignedIn() && request.auth.token.role == 'administrator';
    }

    function isRukn() {
      return isSignedIn() && request.auth.token.role == 'rukn';
    }

    function ruknId() {
      return request.auth.token.ruknId;
    }

    function assignedToRukn(data) {
      return isRukn() && data.ruknId == ruknId();
    }

    function karkunAssignedToRukn(karkunId) {
      return isRukn() &&
        get(/databases/$(database)/documents/karkuns/$(karkunId)).data.assignedRuknId == ruknId();
    }

    function stringOrEmpty(value) {
      return value is string ? value : '';
    }

    /** Safe for legacy docs where referredByRuknId is absent (not ''). */
    function referredByValue(data) {
      return ('referredByRuknId' in data)
        ? stringOrEmpty(data.referredByRuknId)
        : '';
    }

    function referredByUnchanged() {
      return referredByValue(resource.data)
        == referredByValue(request.resource.data);
    }

    /** A Rukn officer docs use AR## ids on the shared rukns collection. */
    function isARuknDocId(id) {
      return id.matches('^AR[0-9]+$');
    }

    /**
     * Admin-only officer create (existing). A Rukn docs must carry officerKind/origin/sourcePersonId.
     * Normal Rukn docs must not be created as officerKind a_rukn.
     */
    function validRuknOfficerCreate(docId) {
      return isARuknDocId(docId)
        ? (
            request.resource.data.id == docId
            && request.resource.data.officerKind == 'a_rukn'
            && request.resource.data.origin == 'promoted_karkun'
            && request.resource.data.sourcePersonId is string
            && request.resource.data.sourcePersonId != ''
          )
        : (
            !('officerKind' in request.resource.data)
            || request.resource.data.officerKind != 'a_rukn'
          );
    }

    function categoryUnchanged() {
      return stringOrEmpty(resource.data.category)
        == stringOrEmpty(request.resource.data.category);
    }

    /** Increment D — Muttafiq must stay outside campaign claim/connect paths. */
    function isMuttafiqPersonData(data) {
      return stringOrEmpty(data.category) == 'Muttafiq';
    }

    function karkunDocExists(karkunId) {
      return karkunId is string
        && karkunId != ''
        && exists(/databases/$(database)/documents/karkuns/$(karkunId));
    }

    function karkunNotMuttafiq(karkunId) {
      return karkunDocExists(karkunId)
        && !isMuttafiqPersonData(
          get(/databases/$(database)/documents/karkuns/$(karkunId)).data
        );
    }

    function isPromotedToARuknData(data) {
      return ('promotedToARuknId' in data)
        && stringOrEmpty(data.promotedToARuknId) != '';
    }

    /** Safe for legacy docs where aRuknPromotionInProgress is absent. */
    function isARuknPromotionInProgressData(data) {
      return ('aRuknPromotionInProgress' in data)
        && data.aRuknPromotionInProgress == true;
    }

    function promotedToARuknIdUnchanged() {
      return stringOrEmpty(resource.data.promotedToARuknId)
        == stringOrEmpty(request.resource.data.promotedToARuknId);
    }

    function aRuknPromotionInProgressUnchanged() {
      return isARuknPromotionInProgressData(resource.data)
        == isARuknPromotionInProgressData(request.resource.data);
    }

    function karkunNotInARuknPromotionTransition(karkunId) {
      return karkunDocExists(karkunId)
        && !isPromotedToARuknData(
          get(/databases/$(database)/documents/karkuns/$(karkunId)).data
        )
        && !isARuknPromotionInProgressData(
          get(/databases/$(database)/documents/karkuns/$(karkunId)).data
        );
    }

    function officerIdentityUnchanged() {
      return stringOrEmpty(resource.data.officerKind)
          == stringOrEmpty(request.resource.data.officerKind)
        && stringOrEmpty(resource.data.origin)
          == stringOrEmpty(request.resource.data.origin)
        && stringOrEmpty(resource.data.sourcePersonId)
          == stringOrEmpty(request.resource.data.sourcePersonId);
    }

    function isAvailableKarkunData(data) {
      return !isPromotedToARuknData(data)
        && !isARuknPromotionInProgressData(data)
        && (
          stringOrEmpty(data.assignedRuknId) == ''
          || data.assignmentStatus == 'Available'
        );
    }

    /** Promoted people must stay off the Available equality query. */
    function promotedKarkunNotAvailable() {
      return !isPromotedToARuknData(request.resource.data)
        || request.resource.data.assignmentStatus != 'Available';
    }

    /**
     * KC-0058.2 / Increment D — Rukn may:
     * - enrich / release own assigned Karkun
     * - claim an Available Karkun on Connect (assignedRuknId '' → self)
     * Never reassign to a different Rukn.
     * Never change referredByRuknId or category.
     * Never claim/update Muttafiq via campaign karkun paths.
     */
    function ruknMayUpdateKarkun() {
      let before = stringOrEmpty(resource.data.assignedRuknId);
      let after = stringOrEmpty(request.resource.data.assignedRuknId);
      return request.resource.data.id == resource.data.id
        && !isMuttafiqPersonData(resource.data)
        && !isPromotedToARuknData(resource.data)
        && !isARuknPromotionInProgressData(resource.data)
        && categoryUnchanged()
        && referredByUnchanged()
        && promotedToARuknIdUnchanged()
        && aRuknPromotionInProgressUnchanged()
        && (
          (before == ruknId() && after == ruknId())
          || (before == '' && after == ruknId())
          || (before == ruknId() && after == '')
        );
    }

    // KC-0058 — critical collections: no client deletes (archive via update only).
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create, update: if isAdministrator();
      allow delete: if false;
    }

    match /rukns/{docId} {
      allow read: if isAdministrator() || (isRukn() && docId == ruknId());
      allow create: if isAdministrator() && validRuknOfficerCreate(docId);
      // Increment C/D — referredByRuknId immutable after create (Admin included).
      allow update: if isAdministrator() && referredByUnchanged() && officerIdentityUnchanged();
      allow delete: if false;
    }

    match /karkuns/{karkunId} {
      // Own connected + Available pool (Connect list).
      allow read: if isAdministrator()
        || (isRukn() && (
          resource.data.assignedRuknId == ruknId()
          || isAvailableKarkunData(resource.data)
        ));
      allow create: if isAdministrator();
      // Increment D — Admin ordinary updates must not rewrite referral attribution.
      allow update: if (isAdministrator() && referredByUnchanged() && promotedKarkunNotAvailable())
        || (isRukn() && ruknMayUpdateKarkun());
      allow delete: if false;
    }

    match /connections/{assignmentId} {
      allow read: if isAdministrator() || assignedToRukn(resource.data);
      // Increment D — Rukn may create only for self + non-Muttafiq person.
      allow create: if (
        isAdministrator()
        || (
          isRukn()
          && assignedToRukn(request.resource.data)
          && request.resource.data.keys().hasAll(['assignmentId', 'ruknId', 'karkunId'])
          && request.resource.data.assignmentId == assignmentId
          && karkunNotMuttafiq(request.resource.data.karkunId)
        )
      ) && karkunNotInARuknPromotionTransition(request.resource.data.karkunId);
      // Increment D — Rukn cannot forge ownership transfer via connection update.
      allow update: if isAdministrator()
        || (
          assignedToRukn(resource.data)
          && request.resource.data.ruknId == resource.data.ruknId
          && request.resource.data.karkunId == resource.data.karkunId
          && request.resource.data.assignmentId == resource.data.assignmentId
        );
      allow delete: if false;
    }

    // KC-0058 — activity append-only (create only).
    match /activityLogs/{entryId} {
      allow read: if isAdministrator() || (isRukn() && resource.data.ruknId == ruknId());
      allow create: if isAdministrator() || (isRukn() && request.resource.data.ruknId == ruknId());
      allow update, delete: if false;
    }

    // KC-0058 — connection ledger append-only.
    match /connectionLedger/{ledgerId} {
      allow read: if isAdministrator();
      allow create: if isAdministrator();
      allow update, delete: if false;
    }

    match /executions/{docId} {
      allow read: if isAdministrator() || isRukn();
      // KC reliability — shared guidance blob (docId == 'guidance') is written by Rukns
      // during execution actions but has no top-level ruknId. Annexure docs keep ruknId scoping.
      allow create: if isAdministrator()
        || (isRukn() && docId == 'guidance')
        || (isRukn() && request.resource.data.ruknId == ruknId());
      allow update: if isAdministrator()
        || (isRukn() && docId == 'guidance')
        || (isRukn() && resource.data.ruknId == ruknId());
      allow delete: if isAdministrator();
    }

    match /followUps/{followUpId} {
      allow read: if isAdministrator() || assignedToRukn(resource.data);
      allow create: if isAdministrator() || assignedToRukn(request.resource.data);
      allow update: if isAdministrator() || assignedToRukn(resource.data);
      allow delete: if isAdministrator();
    }

    /**
     * TD-04 / KC-032 P1 — assignment review requests (one doc per review).
     * Pending locks use doc id pending_{karkunId} with _docType == 'pendingLock'.
     * Rukn: create/read own (ruknId); cannot resolve. Admin: read all + resolve.
     * Delete denied for review docs; Admin may delete pending-lock only.
     */
    function isAssignmentReviewPendingLock() {
      return resource.data.keys().hasAll(['_docType'])
        && resource.data._docType == 'pendingLock';
    }

    function isAssignmentReviewPendingLockCreate() {
      return request.resource.data.keys().hasAll(['_docType', 'karkunId', 'ruknId', 'reviewId'])
        && request.resource.data._docType == 'pendingLock';
    }

    function isAssignmentReviewCreate(reviewId) {
      return request.resource.data.keys().hasAll(['id', 'karkunId', 'ruknId', 'status'])
        && request.resource.data.id == reviewId
        && request.resource.data.status == 'Pending'
        && (
          !request.resource.data.keys().hasAll(['_docType'])
          || request.resource.data._docType != 'pendingLock'
        );
    }

    match /assignmentReviews/{reviewId} {
      allow read: if isAdministrator()
        || (isRukn() && (
             resource == null
             || resource.data.ruknId == ruknId()
           ));

      allow create: if isAdministrator()
        || (isRukn()
          && request.resource.data.ruknId == ruknId()
          && (isAssignmentReviewCreate(reviewId) || isAssignmentReviewPendingLockCreate()));

      allow update: if isAdministrator()
        && !isAssignmentReviewPendingLock()
        && resource.data.status == 'Pending'
        && request.resource.data.status == 'Resolved'
        && request.resource.data.id == resource.data.id
        && request.resource.data.ruknId == resource.data.ruknId
        && request.resource.data.karkunId == resource.data.karkunId;

      allow delete: if isAdministrator() && isAssignmentReviewPendingLock();
    }

    /**
     * Increment A — Rukn ↔ Muttafiq relationship (not campaign connections).
     * Admin establishes Active links; Rukn may read own ruknId rows only.
     */
    match /muttafiqRelationships/{relationshipId} {
      allow read: if isAdministrator()
        || (isRukn() && resource.data.ruknId == ruknId());
      allow create, update: if isAdministrator()
        && request.resource.data.id == relationshipId
        && request.resource.data.keys().hasAll(['id', 'ruknId', 'personId', 'status'])
        && request.resource.data.status == 'Active';
      allow delete: if false;
    }

    match /communications/{docId} {
      allow read, write: if isAdministrator();
    }

    // Phase 1 planning foundation — Admin-owned; archive via update (no client deletes).
    match /meqatiMansoobas/{docId} {
      allow read, create, update: if isAdministrator();
      allow delete: if false;
    }

    match /objectives/{docId} {
      // Rukn may read اہداف names to orient assigned سرگرمیاں. Writes stay Admin.
      allow read: if isAdministrator() || isRukn();
      allow create, update: if isAdministrator();
      allow delete: if false;
    }

    match /shobahs/{docId} {
      // Rukn may read شعبہ names to orient assigned سرگرمیاں. Writes stay Admin.
      allow read: if isAdministrator() || isRukn();
      allow create, update: if isAdministrator();
      allow delete: if false;
    }

    match /units/{docId} {
      allow read, create, update: if isAdministrator();
      allow delete: if false;
    }

    // Phase 2 Local Programme — Admin writes; Rukn may read own ذمہ دار activities.
    match /localProgrammes/{docId} {
      allow read: if isAdministrator()
        || (isRukn() && resource.data.responsibleRuknId == ruknId());
      allow create, update: if isAdministrator();
      allow delete: if false;
    }

    // Phase 3 Occurrence — Admin-owned under Local Programme; archive via update (no client deletes).
    match /occurrences/{docId} {
      allow read, create, update: if isAdministrator();
      allow delete: if false;
    }

    // Phase 4 Responsibility — Admin writes; Rukn may read own (Work contextual auth).
    match /responsibilities/{docId} {
      allow read: if isAdministrator() || assignedToRukn(resource.data);
      allow create, update: if isAdministrator();
      allow delete: if false;
    }

    /**
     * Phase 4 Work — Admin administers. Rukn may read own assignee docs.
     * Rukn update requires linked active Responsibility matching person + unit.
     * Tenure completeness is enforced in canActOnWork (application helper).
     * No client deletes.
     */
    function ruknMayActOnWork(data) {
      return isRukn()
        && data.ruknId == ruknId()
        && data.keys().hasAll(['responsibilityId', 'unitId', 'ruknId'])
        && data.responsibilityId is string
        && data.responsibilityId != ''
        && exists(/databases/$(database)/documents/responsibilities/$(data.responsibilityId))
        && get(/databases/$(database)/documents/responsibilities/$(data.responsibilityId)).data.ruknId == ruknId()
        && get(/databases/$(database)/documents/responsibilities/$(data.responsibilityId)).data.unitId == data.unitId
        && get(/databases/$(database)/documents/responsibilities/$(data.responsibilityId)).data.status == 'active';
    }

    match /work/{docId} {
      allow read: if isAdministrator() || assignedToRukn(resource.data);
      allow create: if isAdministrator();
      allow update: if isAdministrator()
        || (assignedToRukn(resource.data) && ruknMayActOnWork(request.resource.data));
      allow delete: if false;
    }

    /**
     * Compliance docs:
     * - Legacy ijtema / baitulMaal: Rukn may write assigned-karkun records (KC-0084).
     * - KC-0107 weeklyIjtemaEvent: Admin only.
     * - KC-0107 weeklyIjtemaSubmission: Rukn may write own ruknId submission.
     * - jihPortal: Admin only.
     */
    function complianceWriteRecord() {
      return request.resource.data.record;
    }

    function ruknMayWriteComplianceRecord() {
      return isRukn()
        && request.resource.data.keys().hasAll(['record'])
        && complianceWriteRecord().keys().hasAll(['karkunId'])
        && karkunAssignedToRukn(complianceWriteRecord().karkunId)
        && (
          !complianceWriteRecord().keys().hasAll(['ruknId'])
          || complianceWriteRecord().ruknId == null
          || complianceWriteRecord().ruknId == ruknId()
        );
    }

    function ruknMayWriteWeeklyIjtemaSubmission() {
      return isRukn()
        && request.resource.data._docType == 'weeklyIjtemaSubmission'
        && request.resource.data.keys().hasAll(['record'])
        && complianceWriteRecord().keys().hasAll(['ruknId', 'eventId'])
        && complianceWriteRecord().ruknId == ruknId();
    }

    function ruknMayWriteMonthlyBaitulMaalSubmission() {
      return isRukn()
        && request.resource.data._docType == 'monthlyBaitulMaalSubmission'
        && request.resource.data.keys().hasAll(['record'])
        && complianceWriteRecord().keys().hasAll(['ruknId', 'eventId'])
        && complianceWriteRecord().ruknId == ruknId();
    }

    match /compliance/{docId} {
      allow read: if isAdministrator() || isRukn();
      allow create: if isAdministrator()
        || ruknMayWriteComplianceRecord()
        || ruknMayWriteWeeklyIjtemaSubmission()
        || ruknMayWriteMonthlyBaitulMaalSubmission();
      allow update: if isAdministrator()
        || (
          ruknMayWriteComplianceRecord()
          && (
            !resource.data.keys().hasAll(['record'])
            || !resource.data.record.keys().hasAll(['karkunId'])
            || karkunAssignedToRukn(resource.data.record.karkunId)
          )
        )
        || (
          ruknMayWriteWeeklyIjtemaSubmission()
          && (
            !resource.data.keys().hasAll(['record'])
            || !resource.data.record.keys().hasAll(['ruknId'])
            || resource.data.record.ruknId == ruknId()
          )
        )
        || (
          ruknMayWriteMonthlyBaitulMaalSubmission()
          && (
            !resource.data.keys().hasAll(['record'])
            || !resource.data.record.keys().hasAll(['ruknId'])
            || resource.data.record.ruknId == ruknId()
          )
        );
      allow delete: if isAdministrator();
    }

    // KC-0056 — karkunCounter.nextKarkunNum is monotonic (stale clients cannot lag it).
    // KC-0058 — protect connectionMeta from delete.
    // KC-0058.2 — Rukn may read hydrate counters + allocate ASN via connectionMeta;
    //             Rukn may update karkunRequests (Add New Karkun). Default deny otherwise.
    //
    // Increment D — RESIDUAL RISK (accepted without redesign):
    // settings/karkunRequests is a shared blob. Any authorized Rukn may overwrite the
    // full document. Field-level requester/status protection requires per-request docs
    // or a trusted server writer. Mitigations in app layer:
    // - submit validates requestingRuknId against auth/session Rukn
    // - Admin approval is authoritative for create/link + referredBy stamp
    // - Muttafiq relationships are Admin-only writes on muttafiqRelationships
    // Do NOT broaden Rukn write access further.
    match /settings/{docId} {
      allow read: if isAdministrator()
        || (isRukn() && (
          docId == 'connectionMeta'
          || docId == 'karkunCounter'
          || docId == 'migrationVersion'
          || docId == 'karkunRequests'
          || docId == 'ruknAdminMessages'
          || docId == 'notificationPreferences_' + request.auth.uid
        ));

      allow create: if isAdministrator()
        || (isRukn() && (docId == 'karkunRequests' || docId == 'ruknAdminMessages'))
        || (isSignedIn() && docId == 'notificationPreferences_' + request.auth.uid);

      allow update: if (
        isAdministrator() && (
          (
            docId != 'karkunCounter'
            && docId != 'aRuknCounter'
          )
          || (
            docId == 'karkunCounter' && (
              !('nextKarkunNum' in resource.data)
              || request.resource.data.nextKarkunNum >= resource.data.nextKarkunNum
            )
          )
          || (
            docId == 'aRuknCounter' && (
              !('nextARuknNum' in resource.data)
              || request.resource.data.nextARuknNum >= resource.data.nextARuknNum
            )
          )
        )
      ) || (
        isRukn() && docId == 'connectionMeta' &&
        (
          !('nextSequence' in resource.data) ||
          request.resource.data.nextSequence >= resource.data.nextSequence
        )
      ) || (
        isRukn() && (docId == 'karkunRequests' || docId == 'ruknAdminMessages')
      ) || (
        isSignedIn() && docId == 'notificationPreferences_' + request.auth.uid
      );

      allow delete: if isAdministrator()
        && docId != 'karkunCounter'
        && docId != 'aRuknCounter'
        && docId != 'connectionMeta'
        && docId != 'karkunRequests'
        && docId != 'ruknAdminMessages'
        && !docId.matches('^notificationPreferences_.+$');
    }

    /**
     * Training gathering registrations — public clients never read or write.
     * All public create/update goes through Admin SDK after verified phone OTP.
     * Administrators may read for Inbox / counts. Payment confirmation and CSV
     * export are server-authorized administrator actions.
     */
    match /trainingRegistrations/{registrationId} {
      allow read: if isAdministrator();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
